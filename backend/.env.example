# Copy to backend/.env and fill in. Never commit .env.

# ---- LLM ------------------------------------------------------------------
# openai | anthropic | groq   (groq has a free tier: https://console.groq.com)
LLM_PROVIDER=groq

# Set the key for the provider you chose:
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Fast model: intent classification. Strong model: SQL generation, repair,
# optimization, debugging and explanation. Examples per provider:
#   openai:    LLM_FAST_MODEL=gpt-4o-mini            LLM_STRONG_MODEL=gpt-4o
#   anthropic: LLM_FAST_MODEL=claude-haiku-5-5       LLM_STRONG_MODEL=claude-sonnet-5-5
#   groq:      LLM_FAST_MODEL=openai/gpt-oss-20b     LLM_STRONG_MODEL=openai/gpt-oss-120b
#   (Groq retires models often; check https://console.groq.com/docs/models)
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_STRONG_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0

# ---- Database -------------------------------------------------------------
# DATABASE_PATH=app/db/app.db
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=5

# ---- Agent ----------------------------------------------------------------
MAX_RETRIES=3
HISTORY_TURNS=6

# ---- Conversation memory --------------------------------------------------
# Empty = in-memory (lost on restart). Set a file path to persist across restarts.
CHECKPOINT_DB=

# ---- API ------------------------------------------------------------------
# Comma-separated frontend origins. *.vercel.app is always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
